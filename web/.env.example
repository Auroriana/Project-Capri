OWNER_USER_ID=2b0adefe-04f4-4f39-9332-d0287953096b
GEMINI_API_KEY=
# Set true only after confirming this API project is on the free tier.
GEMINI_FREE_TIER_CONFIRMED=false
ENABLE_SEMANTIC_SEARCH=false
# DeepSeek is intentionally disabled in this zero-budget release.
# Quick Note background worker. Server only; never put these in browser code.
# Use a cryptographically random secret of at least 32 characters.
QUICK_WORKER_SECRET=
ARIA_EMAIL=
ARIA_PASSWORD=

# Optional paid Claude API for Core roles. Keys stay on the server.
ANTHROPIC_API_KEY=
CLAUDE_API_ENABLED=false

# Optional closed-site reminders. Generate a VAPID pair using npx web-push generate-vapid-keys.
# Keep the private key and worker secret server-only. ARIA_EMAIL/PASSWORD above authenticate the worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR-CONTACT-EMAIL
REMINDER_WORKER_SECRET=

# Additional server-only completion providers
GROQ_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Free-only is the default. Paid providers remain selectable only when explicitly disabled.
CAPRI_FREE_ONLY=true
# Confirm the account is on a non-billing free tier before enabling it.
GROQ_FREE_TIER_CONFIRMED=true
NVIDIA_FREE_ACCESS_CONFIRMED=true

# Stable server-only encryption secret for browser-entered provider keys.
# If unset, existing GEMINI_API_KEY supplies encryption material. Rotation invalidates saved cookies.
PROVIDER_CREDENTIAL_SECRET=
